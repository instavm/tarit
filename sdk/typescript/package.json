{
  "name": "@tarit/sdk",
  "version": "0.1.2",
  "description": "Typed client for the Tarit Orchestrator API",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instavm/tarit.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/instavm/tarit#readme",
  "bugs": {
    "url": "https://github.com/instavm/tarit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test ../tests/typescript/*.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
