{
  "name": "@tarit/sdk",
  "version": "0.1.0",
  "description": "Typed client for the Tarit Orchestrator API",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test ../tests/typescript/*.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
