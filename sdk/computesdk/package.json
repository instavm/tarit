{
  "name": "@computesdk/tarit",
  "version": "0.1.0",
  "description": "Tarit microVM sandboxes for ComputeSDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instavm/tarit.git",
    "directory": "sdk/computesdk"
